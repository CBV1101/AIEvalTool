# Copy this file to .env.local. Leave a key blank when you do not have it.
# Keys are read on the server only. They are not stored in SQLite and are not sent to the browser.
# The same keys are used for prompt runs and for the separate grader model.
# Restart the app after changing this file.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional. These are the providers' public API hosts.
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Optional. How many provider calls to run at once. Use 1–4. Default is 3.
EVAL_RUN_CONCURRENCY=3

# Optional. Maximum output tokens requested from Anthropic. Default is 1024.
EVAL_MAX_OUTPUT_TOKENS=1024

# Optional. USD per million tokens, keyed by the model identifier you type
# on a prompt version. Until that identifier is listed here, a live run shows
# "Cost unavailable."
# EVAL_MODEL_PRICING={"your-model-id":{"inputPerMillion":3,"outputPerMillion":15}}

# Optional. SQLite file. Default is data/evaluator.sqlite.
# EVAL_DB_PATH=
